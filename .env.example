# Password for the admin UI (create/export/delete rooms). Required.
MASTER_PASSWORD=change-me

# HTTP port. The Docker image uses 3000.
PORT=3000

# Where the SQLite database and recorded audio live. The Docker image uses /data.
DATA_DIR=./data

# Transcription: "qwen" (needs DASHSCOPE_API_KEY) or "fake" (no vendor, for dev).
# Defaults to qwen when DASHSCOPE_API_KEY is set, otherwise fake.
TRANSCRIPTION_PROVIDER=
DASHSCOPE_API_KEY=
# Model Studio workspace; picks the workspace endpoint (Singapore) when set.
DASHSCOPE_WORKSPACE_ID=
QWEN_MODEL=qwen-audio-3.1-asr-flash-streaming
# Defaults to wss://{DASHSCOPE_WORKSPACE_ID}.ap-southeast-1.maas.aliyuncs.com/api-ws/v1/inference,
# or wss://dashscope-intl.aliyuncs.com/api-ws/v1/inference without a workspace ID.
QWEN_URL=
# Optional language hints, comma-separated (up to 4), e.g. "th,en". Empty means auto-detect.
QWEN_LANGUAGE=
# Token prices in USD per million, for the cost shown in admin. Defaults: 0.93 in, 0.70 out
# (international list price). Free quota is not taken into account.
QWEN_INPUT_PRICE_PER_MILLION_USD=
QWEN_OUTPUT_PRICE_PER_MILLION_USD=

# How much faster than realtime to feed backlogged audio after an outage.
# qwen-audio-3.1-asr-flash-streaming gave identical text from 1x to 20x in testing.
CATCHUP_SPEED=3

# Sockudo (Pusher-compatible) for live viewer updates. Leave unset and viewers poll instead.
# Server-side HTTP API base URL:
SOCKUDO_API_URL=http://127.0.0.1:6001
SOCKUDO_APP_ID=live-speech
SOCKUDO_KEY=live-speech-key
SOCKUDO_SECRET=live-speech-secret
# Public WebSocket URL browsers connect to, if different from the API URL (e.g. wss://sockudo.example.com):
SOCKUDO_WS_URL=
